<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Happy Birthday</title>
<style>
  :root{
    --plum: #241338;
    --plum-deep: #180c26;
    --gold: #f2c14e;
    --coral: #ff6f91;
    --cream: #fbf3e7;
    --mint: #6fd6c2;
  }

  * { box-sizing: border-box; }

  html, body{
    margin:0;
    padding:0;
    background: radial-gradient(120% 140% at 50% -10%, var(--plum) 0%, var(--plum-deep) 70%);
    color: var(--cream);
    font-family: "Trebuchet MS", "Segoe UI", sans-serif;
    min-height:100vh;
  }

  @font-face {
    font-family: 'FredokaFallback';
    src: local('Segoe UI');
  }

  .wrap{
    max-width: 560px;
    margin: 0 auto;
    padding: 48px 24px 80px;
    text-align:center;
  }

  h1{
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    font-size: clamp(2rem, 7vw, 2.9rem);
    line-height: 1.15;
    margin: 0 0 8px;
    letter-spacing: 0.2px;
  }

  h1 span{ color: var(--gold); }

  .sub{
    color: rgba(251,243,231,0.72);
    font-size: 1.02rem;
    margin: 0 0 36px;
    line-height:1.5;
  }

  .stage{
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 460px;
    margin: 0 auto;
    border-radius: 28px;
    overflow: hidden;
    background: #0e0716;
    box-shadow:
      0 0 0 2px rgba(242,193,78,0.25),
      0 30px 60px -20px rgba(0,0,0,0.6);
  }

  video{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit: cover;
    transform: scaleX(-1);
  }

  canvas.confetti{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    pointer-events:none;
  }

  .hint{
    position:absolute;
    left:0; right:0; bottom:0;
    padding: 14px 16px 16px;
    background: linear-gradient(to top, rgba(14,7,22,0.92), rgba(14,7,22,0));
    font-size: 0.92rem;
    color: rgba(251,243,231,0.9);
  }

  .status-dot{
    display:inline-block;
    width:8px; height:8px;
    border-radius:50%;
    background: var(--coral);
    margin-right:7px;
    vertical-align: middle;
  }
  .status-dot.ready{ background: var(--mint); }

  .cover{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:18px;
    padding: 20px;
    background: linear-gradient(160deg, rgba(36,19,56,0.55), rgba(24,12,38,0.85));
    text-align:center;
  }

  .cover p{
    margin:0;
    color: rgba(251,243,231,0.85);
    font-size: 0.95rem;
    max-width: 300px;
  }

  button{
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: var(--plum-deep);
    background: var(--gold);
    border: none;
    padding: 13px 28px;
    border-radius: 999px;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  button:hover{ transform: translateY(-1px); }
  button:active{ transform: translateY(0); }
  button:disabled{ opacity:0.6; cursor: default; }

  .reveal{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:10px;
    padding: 24px;
    text-align:center;
    background: rgba(24,12,38,0.72);
    opacity:0;
    pointer-events:none;
    transition: opacity 0.5s ease;
  }
  .reveal.show{ opacity:1; pointer-events:auto; }

  .reveal .big{
    font-family: Georgia, serif;
    font-size: clamp(1.6rem, 8vw, 2.3rem);
    color: var(--gold);
    margin:0;
  }
  .reveal p{
    margin:0;
    max-width: 320px;
    color: var(--cream);
    line-height:1.5;
  }

  .meter{
    margin-top: 22px;
    width: 100%;
    max-width: 320px;
    height: 8px;
    border-radius: 999px;
    background: rgba(251,243,231,0.12);
    overflow: hidden;
    margin-left:auto;
    margin-right:auto;
  }
  .meter-fill{
    height:100%;
    width:0%;
    background: linear-gradient(90deg, var(--coral), var(--gold));
    transition: width 0.08s linear;
  }
  .meter-label{
    margin-top:8px;
    font-size:0.8rem;
    color: rgba(251,243,231,0.6);
  }

  .footnote{
    margin-top:28px;
    font-size:0.82rem;
    color: rgba(251,243,231,0.45);
    line-height:1.6;
  }
</style>
</head>
<body>

<div class="wrap">
  <h1>Happy Birthday,<br><span id="nameSlot">Friend</span></h1>
  <p class="sub">Look at the camera and give it your best smile — it's waiting for one.</p>

  <div class="stage">
    <video id="video" autoplay muted playsinline></video>
    <canvas id="confettiCanvas" class="confetti"></canvas>

    <div class="cover" id="cover">
      <p>This uses your camera to spot a smile, right here in your browser. Nothing is recorded or sent anywhere.</p>
      <button id="startBtn">Turn on camera</button>
    </div>

    <div class="hint" id="hint" style="display:none;">
      <span class="status-dot" id="statusDot"></span><span id="hintText">Loading face model…</span>
    </div>

    <div class="reveal" id="reveal">
      <p class="big">🎉 There it is!</p>
      <p id="revealMessage">Wishing you a year that's as good as that smile. Happy birthday!</p>
    </div>
  </div>

  <div class="meter">
    <div class="meter-fill" id="meterFill"></div>
  </div>
  <div class="meter-label" id="meterLabel">smile meter</div>

  <p class="footnote">Face detection runs locally via MediaPipe — no images ever leave your device.<br>Swap the name and message in the code to make this yours.</p>
</div>

<script type="module">
import {
  FaceLandmarker,
  FilesetResolver
} from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/vision_bundle.mjs";

(async function(){
  const video = document.getElementById('video');
  const cover = document.getElementById('cover');
  const startBtn = document.getElementById('startBtn');
  const hint = document.getElementById('hint');
  const hintText = document.getElementById('hintText');
  const statusDot = document.getElementById('statusDot');
  const reveal = document.getElementById('reveal');
  const meterFill = document.getElementById('meterFill');
  const meterLabel = document.getElementById('meterLabel');
  const confettiCanvas = document.getElementById('confettiCanvas');
  const ctx = confettiCanvas.getContext('2d');

  const SMILE_THRESHOLD = 0.4;   // avg of mouthSmileLeft/Right blendshape scores (0-1)
  const HOLD_SECONDS = 1.2;      // how long the smile must be held
  let holdProgress = 0;
  let celebrated = false;
  let running = false;
  let confettiParticles = [];
  let confettiRunning = false;
  let faceLandmarker = null;

  function resizeCanvas(){
    confettiCanvas.width = confettiCanvas.clientWidth;
    confettiCanvas.height = confettiCanvas.clientHeight;
  }
  window.addEventListener('resize', resizeCanvas);

  async function loadModel(){
    hintText.textContent = 'Loading face model…';
    const filesetResolver = await FilesetResolver.forVisionTasks(
      "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm"
    );
    faceLandmarker = await FaceLandmarker.createFromOptions(filesetResolver, {
      baseOptions: {
        modelAssetPath: "https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task",
        delegate: "GPU"
      },
      outputFaceBlendshapes: true,
      runningMode: "VIDEO",
      numFaces: 1
    });
  }

  async function startCamera(){
    startBtn.disabled = true;
    startBtn.textContent = 'Starting…';
    try {
      await loadModel();
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } },
        audio: false
      });
      video.srcObject = stream;
      await new Promise(res => { video.onloadedmetadata = res; });
      await video.play();
      cover.style.display = 'none';
      hint.style.display = 'block';
      resizeCanvas();
      statusDot.classList.add('ready');
      hintText.textContent = 'Looking for a face…';
      running = true;
      requestAnimationFrame(detectLoop);
    } catch (err) {
      hintText.textContent = 'Camera unavailable: ' + err.message;
      hint.style.display = 'block';
      cover.style.display = 'none';
      console.error(err);
    }
  }

  function detectLoop(){
    if (!running || celebrated) return;

    if (video.readyState >= 2) {
      try {
        const result = faceLandmarker.detectForVideo(video, performance.now());
        const shapes = result.faceBlendshapes && result.faceBlendshapes[0];

        if (!shapes) {
          hintText.textContent = 'Looking for a face…';
          decayMeter();
        } else {
          const cats = shapes.categories;
          const left = cats.find(c => c.categoryName === 'mouthSmileLeft');
          const right = cats.find(c => c.categoryName === 'mouthSmileRight');
          const smile = ((left ? left.score : 0) + (right ? right.score : 0)) / 2;

          if (smile >= SMILE_THRESHOLD) {
            hintText.textContent = 'That\'s a smile! Hold it…';
            holdProgress += 1 / 60; // roughly matches requestAnimationFrame rate
          } else {
            hintText.textContent = 'Face found — now smile!';
            decayMeter();
          }

          holdProgress = Math.max(0, Math.min(HOLD_SECONDS, holdProgress));
          const pct = (holdProgress / HOLD_SECONDS) * 100;
          meterFill.style.width = pct + '%';
          meterLabel.textContent = pct >= 100 ? 'got it!' : 'smile meter';

          if (holdProgress >= HOLD_SECONDS) {
            celebrate();
            return;
          }
        }
      } catch (err) {
        console.error('Detection error:', err);
        hintText.textContent = 'Detection error: ' + err.message;
      }
    }

    requestAnimationFrame(detectLoop);
  }

  function decayMeter(){
    holdProgress = Math.max(0, holdProgress - 0.2);
    const pct = (holdProgress / HOLD_SECONDS) * 100;
    meterFill.style.width = pct + '%';
  }

  function celebrate(){
    if (celebrated) return;
    celebrated = true;
    running = false;
    hint.style.display = 'none';
    reveal.classList.add('show');
    launchConfetti();
  }

  // --- lightweight confetti, no external library ---
  function launchConfetti(){
    resizeCanvas();
    const colors = ['#f2c14e', '#ff6f91', '#6fd6c2', '#fbf3e7'];
    confettiParticles = Array.from({ length: 140 }, () => ({
      x: Math.random() * confettiCanvas.width,
      y: -20 - Math.random() * confettiCanvas.height * 0.5,
      w: 6 + Math.random() * 6,
      h: 8 + Math.random() * 10,
      speedY: 2 + Math.random() * 3,
      speedX: (Math.random() - 0.5) * 2,
      rot: Math.random() * Math.PI,
      rotSpeed: (Math.random() - 0.5) * 0.2,
      color: colors[Math.floor(Math.random() * colors.length)]
    }));

    if (!confettiRunning) {
      confettiRunning = true;
      requestAnimationFrame(animateConfetti);
    }

    // top up a second burst for a fuller effect
    setTimeout(() => {
      confettiParticles.push(...Array.from({ length: 80 }, () => ({
        x: Math.random() * confettiCanvas.width,
        y: -20,
        w: 6 + Math.random() * 6,
        h: 8 + Math.random() * 10,
        speedY: 2 + Math.random() * 3,
        speedX: (Math.random() - 0.5) * 2,
        rot: Math.random() * Math.PI,
        rotSpeed: (Math.random() - 0.5) * 0.2,
        color: colors[Math.floor(Math.random() * colors.length)]
      })));
    }, 500);
  }

  function animateConfetti(){
    ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);

    confettiParticles.forEach(p => {
      p.y += p.speedY;
      p.x += p.speedX;
      p.rot += p.rotSpeed;

      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      ctx.fillStyle = p.color;
      ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
      ctx.restore();
    });

    confettiParticles = confettiParticles.filter(p => p.y < confettiCanvas.height + 30);

    if (confettiParticles.length > 0) {
      requestAnimationFrame(animateConfetti);
    } else {
      confettiRunning = false;
      // gentle follow-up bursts every few seconds to keep the moment alive
      setTimeout(() => { if (celebrated) launchConfetti(); }, 3500);
    }
  }

  startBtn.addEventListener('click', startCamera);
})();
</script>
</body>
</html>
